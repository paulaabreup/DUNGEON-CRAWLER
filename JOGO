int main() {
    char tecla;
    int nx, ny;
    srand(time(NULL));
    
    esconder_cursor(); 

    while (1) {
        if (estado_atual == MENU) {
            system("cls");
            mudar_cor(14);
            printf("=== DUNGEON CRAWLER ===\n");
            mudar_cor(7);
            printf("1. Jogar\n2. Tutorial\n3. Sair\nEscolha: ");
            tecla = _getch();
            if (tecla == '1') { estado_atual = VILA; carregar_fase(); }
            if (tecla == '2') { mostrar_tutorial(); }
            if (tecla == '3') {
                mudar_cor(10);
                printf("\nJogo encerrado. Obrigado por jogar!\n");
                mudar_cor(7);
                return 0;
            }
        } 
        else if (estado_atual >= VILA && estado_atual <= FASE3) {
            desenhar_mapa();
            
            tecla = tolower(_getch());

            nx = px; ny = py;
            
            if (tecla == 'w') { ny--; dir_jogador = '^'; }
            if (tecla == 's') { ny++; dir_jogador = 'v'; }
            if (tecla == 'a') { nx--; dir_jogador = '<'; }
            if (tecla == 'd') { nx++; dir_jogador = '>'; }
            
            if (tecla == 'i') interagir();
            if (tecla == 'o') realizar_ataque();

            if (mapa_render[ny][nx] == ' ' || mapa_render[ny][nx] == '=' || mapa_render[ny][nx] == '@' || mapa_render[ny][nx] == 'O' || mapa_render[ny][nx] == 'L' || mapa_render[ny][nx] == '#' || mapa_render[ny][nx] == 'X' || mapa_render[ny][nx] == 'Y' || mapa_render[ny][nx] == 'Z') {
                px = nx; py = ny;
            }

            if (mapa_render[py][px] == 'L') { 
                estado_atual++; carregar_fase();
            }

            mover_monstros();
            checar_dano_jogador();
        }
        else if (estado_atual == GAMEOVER) {
            system("cls");
            mudar_cor(12);
            printf("\n*** GAME OVER ***\nAs tuas vidas acabaram.\n");
            mudar_cor(7);
            printf("Pressione algo para voltar ao menu.");
            _getch(); vidas = 3; arma_escolhida = 0; estado_atual = MENU;
        }
        else if (estado_atual == VITORIA) {
            system("cls");
            mudar_cor(10);
            printf("\n*** VITORIA! ***\nO grande Mal foi banido da Vila Jutaiteua e a regiao esta a salvo, ihulll parabenssssssssssssss girasssss\n");
            mudar_cor(7);
            _getch(); return 0;
        }
    }
    return 0;
}
